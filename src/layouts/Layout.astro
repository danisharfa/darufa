---
import '../styles/global.css';
import { Navbar } from '@/components/Navbar';
import { Footer } from '@/components/Footer';
import Logo from '@/assets/darufa-logo-horizontal.svg';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = 'Welcome to DARUFA' } = Astro.props;
const pageTitle = title ? `DARUFA - ${title}` : 'DARUFA';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <Navbar client:load>
      <Logo class="h-8 w-auto" />
    </Navbar>
    <slot />
    <Footer client:load>
      <Logo class="h-9 w-auto" />
    </Footer>
  </body>
</html>
