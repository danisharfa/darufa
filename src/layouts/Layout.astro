---
import '../styles/global.css';
import { Navbar } from '@/components/Navbar';
import { Footer } from '@/components/Footer';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = 'Welcome to Darufa' } = Astro.props;
const pageTitle = title ? `Darufa - ${title}` : 'Darufa';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <Navbar client:load />
    <slot />
    <Footer client:load />
  </body>
</html>
