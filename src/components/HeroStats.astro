---
interface Stat {
  value: string;
  label: string;
}

const stats: Stat[] = [
  { value: '500+', label: 'Pelanggan Puas' },
  { value: '100%', label: 'Bahan Pilihan' },
  { value: 'Setiap Hari', label: 'Fresh Dipanggang' },
];
---

<dl class="mt-10 grid w-full max-w-lg grid-cols-3 gap-4 border-t pt-8">
  {
    stats.map((stat) => (
      <div class="flex flex-col items-center gap-1">
        <dt class="text-2xl font-bold text-primary sm:text-3xl">{stat.value}</dt>
        <dd class="text-xs text-muted-foreground sm:text-sm">{stat.label}</dd>
      </div>
    ))
  }
</dl>
