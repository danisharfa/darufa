---
import { Badge } from '@/components/ui/badge';
import { HeroActions } from '@/components/HeroActions';
import HeroCategories from '@/components/HeroCategories.astro';
---

<section class="relative">
  <div
    class="relative mx-auto flex w-full max-w-6xl flex-col items-center gap-6 px-4 py-20 text-center sm:px-6 sm:py-28 lg:px-8"
  >
    <Badge variant="outline" className="bg-muted text-muted-foreground">Pre-Order &amp; Ready Stock</Badge>

    <h1 class="w-full text-balance font-heading text-4xl font-bold tracking-tight text-foreground sm:text-6xl md:text-7xl">
      Kue &amp; Roti Buatan Rumahan
    </h1>

    <p class="w-full max-w-xl text-base text-muted-foreground sm:text-lg">
      Dipesan online, tersedia ready stock atau pre-order. Ambil sendiri atau diantar sesuai area.
    </p>

    <HeroActions client:load />

    <HeroCategories />
  </div>
</section>
