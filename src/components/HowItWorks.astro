---
interface Step {
  number: number;
  title: string;
  description: string;
}

const steps: Step[] = [
  { number: 1, title: 'Pilih Menu', description: 'Lihat katalog, pilih ready stock atau pre-order.' },
  { number: 2, title: 'Pesan via WhatsApp', description: 'Konfirmasi pesanan dan jadwal ambil/antar.' },
  { number: 3, title: 'Kami Siapkan', description: 'Dibuat segar sesuai pesanan dari dapur rumah.' },
  { number: 4, title: 'Ambil / Diantar', description: 'Ambil sendiri atau dikirim sesuai area.' },
];
---

<section class="border-t">
  <div class="mx-auto w-full max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <h2 class="text-center font-heading text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
      Cara Kerja Kami
    </h2>

    <div class="mt-10 grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-4 sm:gap-8">
      {
        steps.map((step) => (
          <div class="flex flex-col items-start gap-2">
            <div class="flex size-9 items-center justify-center rounded-full bg-muted font-heading text-sm font-semibold text-foreground">
              {step.number}
            </div>
            <h3 class="font-heading text-sm font-semibold text-primary">{step.title}</h3>
            <p class="text-sm text-muted-foreground">{step.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
