---
import { getCollection } from 'astro:content';
import { FeaturedProductsCarousel } from '@/components/FeaturedProductsCarousel';

const entries = await getCollection('products', ({ data }) => data.isFeatured);
const products = entries.map((entry) => ({
  id: entry.id,
  name: entry.data.name,
  category: entry.data.category,
  price: entry.data.price,
  isAvailable: entry.data.isAvailable,
  isFeatured: entry.data.isFeatured,
  tags: entry.data.tags,
}));
---

{
  products.length > 0 && (
    <section class="mx-auto w-full max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="mb-8 flex flex-col items-center gap-2 text-center">
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Produk Unggulan</h2>
        <p class="text-muted-foreground">Favorit pelanggan yang paling sering dipesan.</p>
      </div>

      <FeaturedProductsCarousel client:load products={products} />

      <div class="mt-8 flex justify-center">
        <a
          href="/catalog"
          class="text-sm font-medium text-primary underline-offset-4 hover:underline"
        >
          Lihat Semua Menu &rarr;
        </a>
      </div>
    </section>
  )
}
